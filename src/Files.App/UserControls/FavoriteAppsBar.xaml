<UserControl
	x:Class="Files.App.UserControls.FavoriteAppsBar"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:items="using:Files.App.Data.Items"
	Loaded="Bar_Loaded"
	Unloaded="Bar_Unloaded">

	<Grid
		MinHeight="40"
		Padding="8,4"
		AutomationProperties.Name="{helpers:ResourceString Name=FavoriteApps}"
		BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
		BorderThickness="0,0,0,1"
		ColumnSpacing="8">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>

		<TextBlock
			VerticalAlignment="Center"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}"
			Style="{StaticResource CaptionTextBlockStyle}"
			Text="{helpers:ResourceString Name=FavoriteApps}" />

		<ScrollViewer
			Grid.Column="1"
			HorizontalScrollBarVisibility="Auto"
			HorizontalScrollMode="Enabled"
			VerticalScrollBarVisibility="Disabled"
			VerticalScrollMode="Disabled">
			<ItemsControl ItemsSource="{x:Bind Shortcuts}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal" Spacing="4" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="items:FavoriteAppShortcut">
						<Button
							MaxWidth="180"
							AutomationProperties.Name="{x:Bind Name}"
							Click="OpenShortcut_Click"
							Tag="{x:Bind}"
							ToolTipService.ToolTip="{x:Bind Path}">
							<Button.ContextFlyout>
								<MenuFlyout>
									<MenuFlyoutItem Click="RemoveShortcut_Click" Tag="{x:Bind}" Text="{helpers:ResourceString Name=Remove}" />
								</MenuFlyout>
							</Button.ContextFlyout>
							<StackPanel Orientation="Horizontal" Spacing="6">
								<SymbolIcon Symbol="{x:Bind Icon}" />
								<TextBlock MaxWidth="120" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
							</StackPanel>
						</Button>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<Button
			Grid.Column="2"
			AutomationProperties.Name="{helpers:ResourceString Name=AddFavoriteShortcut}"
			ToolTipService.ToolTip="{helpers:ResourceString Name=AddFavoriteShortcut}">
			<Button.Flyout>
				<MenuFlyout>
					<MenuFlyoutItem Click="AddApp_Click" Text="{helpers:ResourceString Name=AddFavoriteApp}" />
					<MenuFlyoutItem Click="AddFolder_Click" Text="{helpers:ResourceString Name=AddFavoriteFolder}" />
				</MenuFlyout>
			</Button.Flyout>
			<SymbolIcon Symbol="Add" />
		</Button>
	</Grid>
</UserControl>
